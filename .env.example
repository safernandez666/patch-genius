# Copy to .env and adjust. The defaults work with this repo's docker-compose.yml.
POSTGRES_USER=vulndemo
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=vulndemo

# Fernet key encrypting the Wazuh credentials stored in the database.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it makes the stored Wazuh password unreadable — it must be re-entered
# in the Configuration tab.
APP_SECRET_KEY=

# Bootstrap account, created only while no user exists. Minimum 12 characters.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Interface Docker publishes port 8000 on. The default only answers on the host
# itself; use 0.0.0.0 (or a specific LAN address, e.g. 192.168.1.10) to let other
# machines on the network open the panel. Anything reachable beyond the LAN should
# sit behind the nginx/TLS setup in deploy/ instead, with this left on loopback.
APP_BIND=127.0.0.1

# Comma-separated origins allowed to call the API. Leave empty for the synthetic
# demo; a deployment reading a real Wazuh must name its origin explicitly.
CORS_ORIGINS=

# Forced rescan (dashboard button). Seconds to wait after restarting an agent
# before re-ingesting: the agent has to come back up, run syscollector and let
# the manager score the new inventory. Also the ceiling on agents per request —
# a restart is disruptive, so a wide selection is refused rather than executed.
WAZUH_RESCAN_DELAY_SECONDS=180
WAZUH_RESCAN_MAX_AGENTS=25
