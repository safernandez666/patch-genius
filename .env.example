# Copy to .env and adjust. The defaults work with this repo's docker-compose.yml.
POSTGRES_USER=vulndemo
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=vulndemo

# Fernet key encrypting the Wazuh credentials stored in the database.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it makes the stored Wazuh password unreadable — it must be re-entered
# in the Configuration tab.
APP_SECRET_KEY=

# Bootstrap account, created only while no user exists. Minimum 12 characters.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Comma-separated origins allowed to call the API. Leave empty for the synthetic
# demo; a deployment reading a real Wazuh must name its origin explicitly.
CORS_ORIGINS=
