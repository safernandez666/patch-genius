  "cards": [
    {
      "dot": "cyan",
      "title": "Collection",
      "items": [
        "Wazuh 4.8+ keeps vulnerability state in the Indexer, not the manager API",
        "A point-in-time freezes the view: the scanner deletes rows as packages are patched"
      ]
    },
    {
      "dot": "amber",
      "title": "Prioritisation",
      "items": [
        "CISA KEV first, then EPSS, then a single weighted score",
        "Feeds are queried by CVE identifier only"
      ]
    },
    {
      "dot": "emerald",
      "title": "History",
      "items": [
        "Resolved and reopened are derived by diffing successive ingests",
        "First-seen dates are recorded here, because Wazuh rewrites detected_at"
      ]
    }
  ]
