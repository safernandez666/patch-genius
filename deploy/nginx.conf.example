# Reverse proxy + TLS para la demo, mismo patrón que el resto de los paneles
# SOC de este proveedor (nginx en el VPS + certbot). Ajustar server_name y
# las rutas de certificado antes de copiar a /etc/nginx/sites-available/.

limit_req_zone $binary_remote_addr zone=vulndemo:10m rate=5r/s;

server {
    listen 80;
    server_name demo.tu-dominio.com;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name demo.tu-dominio.com;

    ssl_certificate     /etc/letsencrypt/live/demo.tu-dominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.tu-dominio.com/privkey.pem;

    # La demo es pública y sin auth: un límite de tasa por IP evita que un
    # visitante (o un bot) sature las asignaciones de seguimiento o el pool
    # de Postgres.
    limit_req zone=vulndemo burst=20 nodelay;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
